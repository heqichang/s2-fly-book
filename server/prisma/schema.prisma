generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  nickname  String
  avatar    String?
  status    String   @default("offline")
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sentFriendRequests     FriendRequest[]        @relation("SentRequests")
  receivedFriendRequests FriendRequest[]        @relation("ReceivedRequests")
  contacts               Contact[]              @relation("UserContacts")
  contactOf              Contact[]              @relation("ContactOf")
  conversationMembers    ConversationMember[]   @relation("ConversationMembers")
  messages               Message[]
  readReceipts           ReadReceipt[]
  teamMembers            TeamMember[]
  departmentMembers      DepartmentMember[]
  ownedTeams             Team[]                 @relation("TeamOwner")
  createdFiles           File[]
  pinnedMessages         PinnedMessage[]
  messageMentions        MessageMention[]
  createdFolders         DocFolder[]
  createdDocuments       Document[]             @relation("DocCreator")
  updatedDocuments       Document[]             @relation("DocUpdater")
  docPermissions         DocPermission[]
  docComments            DocComment[]
  docMentions            DocMention[]
  docRecents             DocRecent[]
  docFavorites           DocFavorite[]
  resolvedComments       DocComment[]           @relation("CommentResolver")

  createdFormTemplates    FormTemplate[]         @relation("FormTemplateCreator")
  updatedFormTemplates    FormTemplate[]         @relation("FormTemplateUpdater")
  formRecords             FormRecord[]           @relation("FormRecordSubmitter")
  createdApprovalTemplates ApprovalTemplate[]    @relation("ApprovalTemplateCreator")
  updatedApprovalTemplates ApprovalTemplate[]    @relation("ApprovalTemplateUpdater")
  initiatedApprovals      ApprovalInstance[]     @relation("ApprovalInitiator")
  approvalTasks           ApprovalTask[]         @relation("ApprovalTaskAssignee")
  approvalActions         ApprovalAction[]       @relation("ApprovalActionActor")
  approvalComments        ApprovalComment[]      @relation("ApprovalCommenter")
  approvalCcRecords       ApprovalCc[]           @relation("ApprovalCcUser")
  approvalNotifications   ApprovalNotification[] @relation("ApprovalNotificationUser")
}

model FriendRequest {
  id        String   @id @default(uuid())
  fromId    String
  toId      String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  from User @relation("SentRequests", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("ReceivedRequests", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
}

model Contact {
  id        String   @id @default(uuid())
  userId    String
  contactId String
  remark    String?
  createdAt DateTime @default(now())

  user    User @relation("UserContacts", fields: [userId], references: [id], onDelete: Cascade)
  contact User @relation("ContactOf", fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([userId, contactId])
}

model Team {
  id          String         @id @default(uuid())
  name        String
  logo        String?
  description String?
  ownerId     String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  owner       User           @relation("TeamOwner", fields: [ownerId], references: [id])
  members     TeamMember[]
  departments Department[]
  conversations Conversation[]
  docFolders  DocFolder[]
  documents   Document[]
  formTemplates   FormTemplate[]
  approvalTemplates ApprovalTemplate[]
  formRecords     FormRecord[]
  approvalInstances ApprovalInstance[]
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  role      String   @default("member")
  joinedAt  DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model Department {
  id             String               @id @default(uuid())
  teamId         String
  name           String
  parentId       String?
  description    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  team           Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  parent         Department?          @relation("DepartmentParent", fields: [parentId], references: [id])
  children       Department[]         @relation("DepartmentParent")
  members        DepartmentMember[]
}

model DepartmentMember {
  id             String   @id @default(uuid())
  departmentId   String
  userId         String
  position       String?
  phone          String?
  email          String?
  joinedAt       DateTime @default(now())

  department     Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
}

model Conversation {
  id             String        @id @default(uuid())
  type           String        @default("single")
  subtype        String?
  name           String?
  avatar         String?
  announcement   String?
  teamId         String?
  departmentId   String?
  lastMessage    String?
  lastMessageAt  DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  team           Team?         @relation(fields: [teamId], references: [id])
  members        ConversationMember[]
  messages       Message[]
  pinnedMessages PinnedMessage[]
}

model ConversationMember {
  id             String        @id @default(uuid())
  conversationId String
  userId         String
  role           String        @default("member")
  unreadCount    Int           @default(0)
  lastReadAt     DateTime?
  joinedAt       DateTime      @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation("ConversationMembers", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String        @id @default(uuid())
  conversationId String
  senderId       String
  type           String        @default("text")
  content        String
  status         String        @default("sent")
  isRecalled     Boolean       @default(false)
  isDeleted      Boolean       @default(false)
  replyToId      String?
  forwardFromId  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo        Message?      @relation("MessageReply", fields: [replyToId], references: [id])
  replies        Message[]     @relation("MessageReply")
  forwardFrom    Message?      @relation("MessageForward", fields: [forwardFromId], references: [id])
  forwards       Message[]     @relation("MessageForward")
  file           File?
  mentions       MessageMention[]
  readReceipts   ReadReceipt[]
  pinnedMessages PinnedMessage[]
}

model MessageMention {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  isAll     Boolean  @default(false)
  createdAt DateTime @default(now())

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PinnedMessage {
  id           String   @id @default(uuid())
  conversationId String
  messageId    String
  pinnedById   String
  createdAt    DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedBy     User         @relation(fields: [pinnedById], references: [id])

  @@unique([conversationId, messageId])
}

model ReadReceipt {
  id         String   @id @default(uuid())
  messageId  String
  userId     String
  readAt     DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model File {
  id          String   @id @default(uuid())
  name        String
  originalName String
  mimeType    String
  size        Int
  url         String
  thumbnail   String?
  messageId   String?  @unique
  uploadedById String
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  message     Message? @relation(fields: [messageId], references: [id])
  uploadedBy  User     @relation(fields: [uploadedById], references: [id])
}

model DocFolder {
  id        String     @id @default(uuid())
  teamId    String
  name      String
  parentId  String?
  createdById String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  team      Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  parent    DocFolder? @relation("FolderParent", fields: [parentId], references: [id])
  children  DocFolder[] @relation("FolderParent")
  documents Document[]
  createdBy User       @relation(fields: [createdById], references: [id])

  @@index([teamId])
  @@index([parentId])
}

model Document {
  id          String     @id @default(uuid())
  teamId      String
  folderId    String?
  title       String     @default("未命名文档")
  content     String     @default("[]")
  createdById String
  updatedById String
  isDeleted   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  team        Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  folder      DocFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdBy   User       @relation("DocCreator", fields: [createdById], references: [id])
  updatedBy   User       @relation("DocUpdater", fields: [updatedById], references: [id])
  permissions DocPermission[]
  comments    DocComment[]
  recents     DocRecent[]
  favorites   DocFavorite[]
  shares      DocShare[]

  @@index([teamId])
  @@index([folderId])
  @@index([createdById])
}

model DocPermission {
  id         String   @id @default(uuid())
  documentId String
  userId     String
  role       String   @default("viewer")
  createdAt  DateTime @default(now())

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
  @@index([userId])
}

model DocComment {
  id          String      @id @default(uuid())
  documentId  String
  userId      String
  content     String
  blockId     String?
  blockText   String?
  parentId    String?
  isResolved  Boolean     @default(false)
  resolvedById String?
  resolvedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  document    Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent      DocComment? @relation("CommentReply", fields: [parentId], references: [id])
  replies     DocComment[] @relation("CommentReply")
  mentions    DocMention[]
  resolvedBy  User?       @relation("CommentResolver", fields: [resolvedById], references: [id])

  @@index([documentId])
  @@index([parentId])
  @@index([userId])
}

model DocMention {
  id        String     @id @default(uuid())
  commentId String
  userId    String
  createdAt DateTime   @default(now())

  comment   DocComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DocRecent {
  id         String   @id @default(uuid())
  userId     String
  documentId String
  openedAt   DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([userId, documentId])
  @@index([userId])
}

model DocFavorite {
  id         String   @id @default(uuid())
  userId     String
  documentId String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([userId, documentId])
  @@index([userId])
}

model DocShare {
  id          String   @id @default(uuid())
  documentId  String
  shareType   String   @default("private")
  teamRole    String?
  linkEnabled Boolean  @default(false)
  linkRole    String?
  linkToken   String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId])
}

// ==================== 表单模块 ====================

model FormTemplate {
  id          String     @id @default(uuid())
  teamId      String
  name        String
  icon        String?
  description String?
  category    String?
  isEnabled   Boolean    @default(true)
  isDefault   Boolean    @default(false)
  sortOrder   Int        @default(0)
  createdById String
  updatedById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  team        Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy   User                @relation("FormTemplateCreator", fields: [createdById], references: [id])
  updatedBy   User                @relation("FormTemplateUpdater", fields: [updatedById], references: [id])
  fields      FormField[]
  approvals   ApprovalTemplate[]
  records     FormRecord[]
  instances   ApprovalInstance[]

  @@index([teamId])
}

model FormField {
  id            String   @id @default(uuid())
  formTemplateId String
  fieldKey      String
  label         String
  type          String
  placeholder   String?
  helpText      String?
  defaultValue  String?
  isRequired    Boolean  @default(false)
  isHidden      Boolean  @default(false)
  isDisabled    Boolean  @default(false)
  sortOrder     Int      @default(0)
  options       String?
  validation    String?
  config        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  formTemplate  FormTemplate @relation(fields: [formTemplateId], references: [id], onDelete: Cascade)

  @@index([formTemplateId])
  @@unique([formTemplateId, fieldKey])
}

model FormRecord {
  id              String     @id @default(uuid())
  formTemplateId  String
  approvalInstanceId String?
  submitterId     String
  teamId          String
  formData        String
  status          String     @default("draft")
  submittedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  formTemplate    FormTemplate @relation(fields: [formTemplateId], references: [id], onDelete: Cascade)
  submitter       User         @relation("FormRecordSubmitter", fields: [submitterId], references: [id])
  team            Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([formTemplateId])
  @@index([submitterId])
  @@index([teamId])
  @@index([approvalInstanceId])
}

// ==================== 审批模块 ====================

model ApprovalTemplate {
  id              String     @id @default(uuid())
  formTemplateId  String
  teamId          String
  name            String
  description     String?
  isEnabled       Boolean    @default(true)
  timeoutHours    Int?
  createdById     String
  updatedById     String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  formTemplate    FormTemplate   @relation(fields: [formTemplateId], references: [id], onDelete: Cascade)
  team            Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy       User           @relation("ApprovalTemplateCreator", fields: [createdById], references: [id])
  updatedBy       User           @relation("ApprovalTemplateUpdater", fields: [updatedById], references: [id])
  nodes           ApprovalNode[]
  instances       ApprovalInstance[]

  @@index([formTemplateId])
  @@index([teamId])
}

model ApprovalNode {
  id                  String   @id @default(uuid())
  approvalTemplateId  String
  parentNodeId        String?
  nodeType            String
  nodeName            String
  sortOrder           Int      @default(0)
  assigneeType        String?
  assigneeIds         String?
  assigneeFieldKey    String?
  signType            String?
  conditionExpression String?
  autoAction          String?
  ccUserIds           String?
  config              String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  approvalTemplate    ApprovalTemplate @relation(fields: [approvalTemplateId], references: [id], onDelete: Cascade)
  parentNode          ApprovalNode?    @relation("ApprovalNodeParent", fields: [parentNodeId], references: [id])
  childNodes          ApprovalNode[]   @relation("ApprovalNodeParent")
  tasks               ApprovalTask[]
  currentInstances    ApprovalInstance[] @relation("ApprovalCurrentNode")
  ccRecords           ApprovalCc[]

  @@index([approvalTemplateId])
}

model ApprovalInstance {
  id                  String     @id @default(uuid())
  approvalTemplateId  String
  formRecordId        String?
  formTemplateId      String
  formData            String
  initiatorId         String
  teamId              String
  title               String
  status              String     @default("pending")
  currentNodeId       String?
  startedAt           DateTime?
  completedAt         DateTime?
  deadlineAt          DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  approvalTemplate    ApprovalTemplate  @relation(fields: [approvalTemplateId], references: [id], onDelete: Cascade)
  formTemplate        FormTemplate      @relation(fields: [formTemplateId], references: [id], onDelete: Cascade)
  initiator           User              @relation("ApprovalInitiator", fields: [initiatorId], references: [id])
  team                Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  currentNode         ApprovalNode?     @relation("ApprovalCurrentNode", fields: [currentNodeId], references: [id])
  tasks               ApprovalTask[]
  actions             ApprovalAction[]
  comments            ApprovalComment[]
  ccs                 ApprovalCc[]
  notifications       ApprovalNotification[]

  @@index([approvalTemplateId])
  @@index([initiatorId])
  @@index([teamId])
  @@index([status])
}

model ApprovalTask {
  id                  String     @id @default(uuid())
  approvalInstanceId  String
  approvalNodeId      String
  assigneeId          String
  status              String     @default("pending")
  action              String?
  comment             String?
  assignedAt          DateTime   @default(now())
  actedAt             DateTime?
  deadlineAt          DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  approvalInstance    ApprovalInstance @relation(fields: [approvalInstanceId], references: [id], onDelete: Cascade)
  approvalNode        ApprovalNode     @relation(fields: [approvalNodeId], references: [id], onDelete: Cascade)
  assignee            User             @relation("ApprovalTaskAssignee", fields: [assigneeId], references: [id])
  notifications       ApprovalNotification[]

  @@index([approvalInstanceId])
  @@index([assigneeId])
  @@index([status])
}

model ApprovalAction {
  id                  String     @id @default(uuid())
  approvalInstanceId  String
  actorId             String
  actionType          String
  actionStatus        String
  comment             String?
  fromNodeId          String?
  toNodeId            String?
  targetUserId        String?
  extraData           String?
  createdAt           DateTime   @default(now())

  approvalInstance    ApprovalInstance @relation(fields: [approvalInstanceId], references: [id], onDelete: Cascade)
  actor               User             @relation("ApprovalActionActor", fields: [actorId], references: [id])

  @@index([approvalInstanceId])
  @@index([actorId])
}

model ApprovalComment {
  id                  String     @id @default(uuid())
  approvalInstanceId  String
  commenterId         String
  content             String
  parentId            String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  approvalInstance    ApprovalInstance  @relation(fields: [approvalInstanceId], references: [id], onDelete: Cascade)
  commenter           User              @relation("ApprovalCommenter", fields: [commenterId], references: [id])
  parent              ApprovalComment?  @relation("ApprovalCommentParent", fields: [parentId], references: [id])
  replies             ApprovalComment[] @relation("ApprovalCommentParent")

  @@index([approvalInstanceId])
}

model ApprovalCc {
  id                  String     @id @default(uuid())
  approvalInstanceId  String
  approvalNodeId      String?
  ccUserId            String
  readAt              DateTime?
  createdAt           DateTime   @default(now())

  approvalInstance    ApprovalInstance @relation(fields: [approvalInstanceId], references: [id], onDelete: Cascade)
  approvalNode        ApprovalNode?    @relation(fields: [approvalNodeId], references: [id])
  ccUser              User             @relation("ApprovalCcUser", fields: [ccUserId], references: [id])

  @@unique([approvalInstanceId, ccUserId])
  @@index([ccUserId])
}

model ApprovalNotification {
  id                  String     @id @default(uuid())
  userId              String
  approvalInstanceId  String
  approvalTaskId      String?
  notificationType    String
  title               String
  content             String?
  isRead              Boolean    @default(false)
  readAt              DateTime?
  createdAt           DateTime   @default(now())

  user                User               @relation("ApprovalNotificationUser", fields: [userId], references: [id])
  approvalInstance    ApprovalInstance   @relation(fields: [approvalInstanceId], references: [id], onDelete: Cascade)
  approvalTask        ApprovalTask?      @relation(fields: [approvalTaskId], references: [id])

  @@index([userId])
  @@index([approvalInstanceId])
}
